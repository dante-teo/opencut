{
  "name": "@opencut/media",
  "version": "0.18.3",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render-options": {
      "types": "./dist/render-options.d.ts",
      "import": "./dist/render-options.js"
    }
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node native/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@opencut/shared": "workspace:*",
    "@xmldom/xmldom": "0.9.12",
    "lru-cache": "^11.5.3",
    "sharp": "0.35.5"
  },
  "optionalDependencies": {
    "@opencut/graphics": "workspace:*"
  }
}
