{
  "name": "@opencut/cli",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "bin": {
    "opencut": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node native/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opencut/core": "workspace:*",
    "@opencut/media": "workspace:*"
  }
}
