{
  "name": "@opencut/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "opencut": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opencut/core": "workspace:*",
    "@opencut/media": "workspace:*",
    "@opencut/shared": "workspace:*"
  }
}
