{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM"]
  },
  "exclude": ["tests/fixtures/generated"],
  "include": [
    "scripts/**/*.ts",
    "examples/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "packages/**/*.test.ts",
    "apps/**/*.test.ts"
  ]
}
